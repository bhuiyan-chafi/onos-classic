{
  "name": "onos-gui",
  "version": "3.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),nm=p.resolve(__dirname,'node_modules'),web=p.resolve(__dirname,'..'),root=p.resolve(__dirname,'../..'); [web,root].forEach(d=>{try{fs.unlinkSync(d+'/node_modules')}catch(e){}; fs.symlinkSync(nm,d+'/node_modules','dir'); console.log('symlinked',d+'/node_modules')});\"",
    "build": "bazel build //web/gui:onos-web-gui",
    "build:prod": "bazel build //web/gui:onos-web-gui-prod",
    "build:prebuilt": "bazel build --define prebuilt_gui=true //web/gui:onos-web-gui",
    "build:headless": "bazel build --define skip_gui=true //web/gui:onos-web-gui",
    "build:ng": "ng build",
    "build:ng:prod": "ng build --configuration production",
    "export-dist": "mkdir -p dist && cp -r ../../bazel-bin/web/gui/src/main/webapp/prodapp/* dist/",
    "package": "bazel build //web/gui:onos-web-gui-oar",
    "serve": "ng serve",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "d3": "^7.9.0",
    "rxjs": "^7.8.1",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular/cli": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular-devkit/build-angular": "^18.2.0",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.0.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.5"
  }
}
